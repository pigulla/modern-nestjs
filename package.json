{
  "name": "modern-nestjs",
  "version": "0.0.1",
  "private": true,
  "description": "Highly opinionated, modern setup for NestJS-projects.",
  "bugs": {
    "url": "https://github.com/pigulla/modern-nestjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pigulla/modern-nestjs"
  },
  "license": "ISC",
  "author": {
    "name": "Raphael Pigulla",
    "email": "raphael@pigulla.net",
    "url": "https://de.linkedin.com/in/pigulla"
  },
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "dist": "./dist/src/*"
    }
  },
  "scripts": {
    "audit": "npm audit --omit dev --audit-level high",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && npm run build:copy-config && npm run build:copy-sql",
    "build:copy-config": "rsync --archive --include '*/' --exclude 'local*' config/ dist/config",
    "build:copy-sql": "rsync --archive --prune-empty-dirs --include '*/' --include '*.sql' --exclude '*' src/ dist/src && rsync --archive --prune-empty-dirs --include '*/' --include '*.sql' --exclude '*' migrations/ dist/migrations",
    "format": "npm run format:biome && npm run format:package-json && npm run format:sql",
    "format:biome": "biome check --write",
    "format:package-json": "sort-package-json",
    "format:sql": "NODE_OPTIONS='--conditions development' jiti scripts/sql-formatter.ts format",
    "lint": "npm run lint:tsc && npm run lint:biome && npm run lint:knip && npm run lint:sql && npm run lint:lockfile && npm run lint:package-json",
    "lint:biome": "biome check",
    "lint:knip": "knip --no-exit-code",
    "lint:lockfile": "lockfile-lint",
    "lint:package-json": "npmPkgJsonLint . && sort-package-json --check",
    "lint:sql": "NODE_OPTIONS='--conditions development' jiti scripts/sql-formatter.ts lint",
    "lint:tsc": "tsc",
    "openapi": "npm run openapi:build && npm run openapi:html && npm run openapi:lint",
    "openapi:build": "NODE_OPTIONS='--conditions development' jiti scripts/build-openapi-spec.ts > openapi.json",
    "openapi:html": "redocly build-docs openapi.json --output=openapi.html",
    "openapi:lint": "redocly lint openapi.json",
    "start": "NODE_OPTIONS='--conditions development' jiti src/index.ts",
    "start:dist": "NODE_OPTIONS='--conditions dist' node dist/src/index.js",
    "test": "npm run lint && npm run vitest && npm run audit",
    "vitest": "npm run vitest:unit && npm run vitest:integration && npm run vitest:architecture",
    "vitest:architecture": "vitest run --passWithNoTests --slowTestThreshold 30000 --testTimeout 30000 test/architecture",
    "vitest:coverage": "vitest run --coverage --exclude test/architecture",
    "vitest:integration": "vitest run test/integration",
    "vitest:unit": "vitest run src"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@nestjs-cls/transactional": "3.2.0",
    "@nestjs-cls/transactional-adapter-pg-promise": "1.4.5",
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.4.1",
    "config": "4.4.1",
    "dayjs": "1.11.20",
    "glob": "13.0.6",
    "nestjs-cls": "6.2.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.3.0",
    "pg-promise": "12.6.2",
    "pg-protocol": "1.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@nestjs/testing": "11.1.19",
    "@redocly/cli": "2.29.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.30",
    "@testcontainers/postgresql": "11.14.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "25.6.0",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.5",
    "cz-conventional-changelog": "3.3.0",
    "jiti": "2.6.1",
    "knip": "6.6.2",
    "lockfile-lint": "5.0.0",
    "node-pg-migrate": "8.0.4",
    "npm-package-json-lint": "10.2.1",
    "npm-package-json-lint-config-default": "9.0.1",
    "pino-pretty": "13.1.3",
    "sort-package-json": "3.6.1",
    "source-map-support": "0.5.21",
    "sql-formatter": "15.7.3",
    "supertest": "7.2.2",
    "tsarch": "5.4.1",
    "type-fest": "5.6.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vite": "8.0.10",
    "vitest": "4.1.5",
    "yaml": "2.8.3"
  }
}
